import { render, fireEvent } from "@testing-library/vue";
import { describe, it, expect, vi } from "vitest";
import RouterLinkComponent from "./RouterLinkComponent.vue";

vi.spyOn(window, "scrollTo").mockImplementation(() => {});

describe("RouterLinkComponent", () => {
  it("should call handleNvigation on click", async () => {
    const { getByText } = render(RouterLinkComponent, {
      props: { route: "test-route" },
    });

    const link = getByText("Test Link"); // Assuming RouterLinkComponent renders a link with text "Test Link"
    await fireEvent.click(link);

    expect(window.scrollTo).toHaveBeenCalled();
  });
});
