import { describe, it, vi, beforeEach, afterEach, expect } from "vitest";
import { render, fireEvent } from "@testing-library/react";
import { RouterLinkComponent } from "./RouterLinkComponent";

function mockElementInDOM(id, top) {
  const el = document.createElement("div");
  el.id = id;
  el.getBoundingClientRect = () => ({
    top,
  });
  document.body.appendChild(el);
  return el;
}

describe("handleNvigation and RouterLinkComponent", () => {
  beforeEach(() => {
    // Mock `window.scrollTo`
    vi.spyOn(window, "scrollTo").mockImplementation(() => {});
  });

  afterEach(() => {
    // Clean up mocks and DOM
    vi.restoreAllMocks();
    document.body.innerHTML = "";
  });

  it("should scroll to the correct position when the element exists", () => {
    const route = "test-route";
    mockElementInDOM(route, 500);

    const { getByTestId } = render(<RouterLinkComponent route={route} />);
    const button = getByTestId("router-link");

    fireEvent.click(button);

    const expectedOffset = 500 + window.scrollY - 160; // `elpos + window.scrollY - headerOffset`
    expect(window.scrollTo).toHaveBeenCalledWith({
      top: expectedOffset,
      behaviour: "smooth",
    });
  });

  it("should not call scrollTo if the element does not exist", () => {
    const route = "non-existent-route";

    const { getByTestId } = render(<RouterLinkComponent route={route} />);
    const button = getByTestId("router-link");

    fireEvent.click(button);

    expect(window.scrollTo).not.toHaveBeenCalled();
  });

  it("should render the RouterLinkComponent and respond to clicks", () => {
    const route = "test-route";
    const { getByTestId } = render(<RouterLinkComponent route={route} />);

    const button = getByTestId("router-link");
    expect(button).toBeInTheDocument();

    fireEvent.click(button);
    expect(window.scrollTo).toHaveBeenCalled();
  });
});
