import clsx from "clsx";
import { RouterLink } from "@fiserv/ui-extensions";
import type { NavProps } from "../utils/cardCommonInfoTypes";

function RouterNavLink(props: NavProps) {
  const cardNavLinkStyles = clsx(
    "block rounded",
    "px-4",
    "py-2.5",
    "text-base",
    "font-normal",
    "text-primary",
    "transition-all",
    "hover:bg-[#F4F4F4]"
  );

  function handleClick(e: React.MouseEvent<HTMLAnchorElement, MouseEvent>) {
    e.preventDefault();

    if (props.onClick) {
      props.onClick(e);
    } else {
      window.location.assign("/myca" + props.route);
    }
  }

  return (
    <RouterLink
      className={cardNavLinkStyles}
      onClick={handleClick}
      to={props.route}
    >
      {props.navTextName}
    </RouterLink>
  );
}

export default RouterNavLink;



import { render, screen } from "@testing-library/react";
import { vi } from "vitest";
import RouterNavLink from "../../src/components/RouterNavigationLink";

vi.mock("@fiserv/ui-extensions", () => ({
  RouterLink: vi.fn(
    ({
      children,
      to,
      className,
    }: {
      children: string;
      to: string;
      className: string;
    }) => {
      return (
        <a href={to} className={className} data-testid="router-link">
          {children}
        </a>
      );
    }
  ),
}));

describe("RouterNavLink Component", () => {
  it("Applys the correct Route", () => {
    render(<RouterNavLink navTextName="Card Management" route="/" />);

    const link = screen.getByText("Card Management");

    expect(link).toHaveAttribute("href", "/");
  });

  it("renders correct Class names", () => {
    render(<RouterNavLink navTextName="Personal Details" route="/" />);

    const link = screen.getByText("Personal Details");

    expect(link).toHaveClass("block");
    expect(link).toHaveClass("px-4");
    expect(link).toHaveClass("py-2.5");
    expect(link).toHaveClass("font-normal");
    expect(link).toHaveClass("text-primary");
    expect(link).toHaveClass("transition-all");
    expect(link).toHaveClass("hover:bg-[#F4F4F4]");
  });

  it("renders Nav Text", () => {
    render(<RouterNavLink navTextName="Personal Details" route="/" />);

    const link = screen.getByText("Personal Details");

    expect(link).toBeInTheDocument();
    expect(link).toHaveClass("block");
  });
});
