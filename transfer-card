import { render, screen, fireEvent } from "@testing-library/react";
import { describe, expect, it, vi, beforeEach, afterEach } from "vitest";
import { createRoutesStub } from "@fiserv/util-testing";
import QuickLinksNavigation from "../../src/components/QuickLinksNavigation";

describe("QuickLinksNavigation Component", () => {
  const Stub = createRoutesStub([
    {
      path: "*",
      Component: () => <QuickLinksNavigation />,
    },
  ]);

  const dummyNavLinks = [
    { route: "card-management", navTextName: "Card Management" },
    { route: "personal-details", navTextName: "Personal Details" },
    { route: "communication-online-statement", navTextName: "Communication & Online Statement" },
  ];

  // Mocking QuickNavLink to replace its implementation
  vi.mock("../utils/navigationLinks", () => ({
    QuickNavLink: dummyNavLinks,
  }));

  beforeEach(() => {
    vi.spyOn(window, "scrollTo").mockImplementation(() => {}); // Mock scrollTo
    document.body.innerHTML = ""; // Reset DOM between tests
  });

  afterEach(() => {
    vi.restoreAllMocks(); // Restore original mocks
  });

  it("renders correctly with header", () => {
    render(<Stub />);

    // Verify header text is rendered
    expect(screen.getByText(/Quick Links/i)).toBeInTheDocument();
  });

  it("renders all links based on QuickNavLink", () => {
    render(<Stub />);

    // Verify all navigation links are rendered
    dummyNavLinks.forEach((link) => {
      expect(screen.getByText(link.navTextName)).toBeInTheDocument();
    });
  });

  it("calls handleNavigation and scrolls to the correct position when link is clicked", () => {
    render(<Stub />);

    // Mock an element in the DOM
    const mockElement = document.createElement("div");
    mockElement.id = "card-management";
    mockElement.getBoundingClientRect = () => ({
      top: 500, // Simulating the element position
    });
    document.body.appendChild(mockElement);

    // Simulate a click on the first navigation link
    const link = screen.getByText("Card Management");
    fireEvent.click(link);

    // Validate that scrollTo was called with the correct offset
    const expectedOffset = 500 + window.scrollY - 160; // top + scrollY - headerOffset
    expect(window.scrollTo).toHaveBeenCalledWith({
      top: expectedOffset,
      behavior: "smooth",
    });
  });

  it("does not call scrollTo if the element does not exist", () => {
    render(<Stub />);

    // Simulate a click on a link without the corresponding DOM element
    const link = screen.getByText("Personal Details");
    fireEvent.click(link);

    // Ensure scrollTo is not called
    expect(window.scrollTo).not.toHaveBeenCalled();
  });

  it("renders dynamic links with RouterNavigationLink component", () => {
    render(<Stub />);

    // Verify that RouterNavigationLink receives the correct props
    const links = screen.getAllByRole("link"); // Assuming RouterNavigationLink renders <a> tags
    expect(links).toHaveLength(dummyNavLinks.length);

    links.forEach((link, index) => {
      expect(link).toHaveAttribute("href", `#${dummyNavLinks[index].route}`);
      expect(link.textContent).toBe(dummyNavLinks[index].navTextName);
    });
  });

  it("handles click event and executes the onClick handler in RouterNavigationLink", () => {
    render(<Stub />);

    // Simulate a click and verify onClick is called
    const link = screen.getByText("Communication & Online Statement");
    fireEvent.click(link);

    // Validate scrollTo is attempted (will fail gracefully if element not found)
    expect(window.scrollTo).toHaveBeenCalledTimes(1);
  });
});
