import { render, screen, fireEvent } from "@testing-library/react";
import { vi } from "vitest";
import RouterNavLink from "../../src/components/RouterNavigationLink";

vi.mock("@fiserv/ui-extensions", () => ({
  RouterLink: vi.fn(
    ({
      children,
      to,
      className,
    }: {
      children: string;
      to: string;
      className: string;
    }) => {
      return (
        <a href={to} className={className} data-testid="router-link">
          {children}
        </a>
      );
    }
  ),
}));

describe("RouterNavLink Component", () => {
  const mockOnClick = vi.fn();
  let locationAssignSpy: jest.SpyInstance;

  beforeEach(() => {
    mockOnClick.mockClear();
    locationAssignSpy = vi.spyOn(window.location, "assign").mockImplementation(() => {});
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  it("applies the correct route", () => {
    render(<RouterNavLink navTextName="Card Management" route="/card-management" />);

    const link = screen.getByText("Card Management");

    expect(link).toHaveAttribute("href", "/card-management");
  });

  it("renders correct class names", () => {
    render(<RouterNavLink navTextName="Personal Details" route="/" />);

    const link = screen.getByText("Personal Details");

    expect(link).toHaveClass("block");
    expect(link).toHaveClass("px-4");
    expect(link).toHaveClass("py-2.5");
    expect(link).toHaveClass("font-normal");
    expect(link).toHaveClass("text-primary");
    expect(link).toHaveClass("transition-all");
    expect(link).toHaveClass("hover:bg-[#F4F4F4]");
  });

  it("renders the navigation text", () => {
    render(<RouterNavLink navTextName="Personal Details" route="/" />);

    const link = screen.getByText("Personal Details");

    expect(link).toBeInTheDocument();
    expect(link).toHaveClass("block");
  });

  it("calls the provided onClick handler when clicked", () => {
    render(<RouterNavLink navTextName="Communication" route="/" onClick={mockOnClick} />);

    const link = screen.getByText("Communication");
    fireEvent.click(link);

    expect(mockOnClick).toHaveBeenCalledTimes(1);
  });

  it("calls window.location.assign when onClick is not provided", () => {
    render(<RouterNavLink navTextName="Settings" route="/settings" />);

    const link = screen.getByText("Settings");
    fireEvent.click(link);

    expect(locationAssignSpy).toHaveBeenCalledWith("/myca/settings");
  });

  it("handles missing route gracefully", () => {
    render(<RouterNavLink navTextName="Missing Route" route="" />);

    const link = screen.getByText("Missing Route");

    expect(link).toHaveAttribute("href", "");
  });

  it("handles missing navTextName gracefully", () => {
    render(<RouterNavLink navTextName="" route="/test" />);

    const link = screen.getByTestId("router-link");

    expect(link).toHaveAttribute("href", "/test");
    expect(link.textContent).toBe("");
  });

  it("handles empty props without crashing", () => {
    // @ts-ignore - Intentionally passing undefined props to test resilience
    render(<RouterNavLink />);

    const link = screen.getByTestId("router-link");

    expect(link).toHaveAttribute("href", "");
    expect(link.textContent).toBe("");
  });
});
